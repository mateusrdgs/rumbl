<RumblWeb.Layouts.app flash={@flash} current_scope={@current_scope}>
  <h1>Listing users</h1>
  <.list>
    <:item :for={user <- @users} title={first_name(user) <> " (#{user.id})"}>
      <.link class="btn btn-link" navigate={~p"/users/#{user.id}"}>View</.link>
    </:item>
  </.list>
</RumblWeb.Layouts.app>
